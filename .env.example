# MarkMe Configuration
# Copy this file to .env and configure for your environment.

# ==========================================
# 1. College Domain Restriction
# ==========================================
AUTHORIZED_DOMAIN=ssn.edu.in

# ==========================================
# 2. Google OAuth 2.0 Credentials (Google Cloud Console)
# ==========================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# For local dev: http://localhost:8000/google/callback or http://localhost:8000/api/auth/google/callback
# For production: https://your-backend.onrender.com/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/google/callback

# ==========================================
# 3. Session Security
# ==========================================
# In production, set to a strong random 64-char key (e.g. `openssl rand -hex 32`)
SESSION_SECRET=your-secure-random-session-secret-change-in-production
SESSION_EXPIRE_DAYS=30
SESSION_EXPIRE_HOURS=720

# Cookie Security (Auto-defaults to True in production when DEV_MODE=False)
# Set SESSION_COOKIE_SECURE=True for HTTPS
# For decoupled hosting (e.g. frontend on vercel.app, backend on onrender.com):
# Set SESSION_COOKIE_SAMESITE=none and SESSION_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=lax

# ==========================================
# 4. Mode & Local Mock Settings
# ==========================================
# Set to False in production
DEV_MODE=True
DEV_LOCAL_WORKBOOK_PATH=/home/sreenath/Sree/Projects/MarkMe/V Sem B Attendance sheet.xlsx

# ==========================================
# 5. Frontend Origins (for CORS)
# ==========================================
# Production frontend URL (without trailing slash)
FRONTEND_URL=http://localhost:5173
# Optional: comma-separated list of additional allowed origins
ALLOWED_ORIGINS=https://markme.vercel.app,https://your-custom-domain.com
