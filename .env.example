# MarkMe Production Configuration
# Copy this file to .env and configure for your deployment environment.

# ==========================================
# 1. College Domain Restriction
# ==========================================
AUTHORIZED_DOMAIN=ssn.edu.in

# ==========================================
# 2. Google OAuth 2.0 Credentials (Google Cloud Console)
# ==========================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Production callback URI registered in Google Cloud Console
GOOGLE_REDIRECT_URI=https://markme-zrfk.onrender.com/google/callback

# ==========================================
# 3. Session Security & Cookies
# ==========================================
# Strong random 64-character secret key (e.g. `openssl rand -hex 32`)
SESSION_SECRET=your-secure-random-session-secret-change-in-production
SESSION_EXPIRE_DAYS=30
SESSION_EXPIRE_HOURS=720

# Production Cookie Security (HTTPS)
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=lax

# ==========================================
# 4. Frontend Origins (for CORS)
# ==========================================
# Production frontend URL (without trailing slash)
FRONTEND_URL=https://frontend-iota-plum-38.vercel.app
# Optional: comma-separated list of additional allowed origins
ALLOWED_ORIGINS=https://frontend-iota-plum-38.vercel.app
