# MarkMe Configuration

# Authorized College Google Workspace Domain
AUTHORIZED_DOMAIN=ssn.edu.in

# Google OAuth 2.0 Credentials (Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Session Security (Generate a strong random string in production)
SESSION_SECRET=your-secure-random-session-secret-change-in-production
SESSION_EXPIRE_HOURS=24

# Development / Offline Mock Mode
# Set to True to allow testing without active Google Cloud API credentials
DEV_MODE=True
DEV_LOCAL_WORKBOOK_PATH=/home/sreenath/Sree/Projects/MarkMe/V Sem B Attendance sheet.xlsx

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
